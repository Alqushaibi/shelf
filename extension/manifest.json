{
  "manifest_version": 3,
  "name": "Shelf \u2013 Tab Organizer",
  "version": "0.4.1",
  "description": "Organize tabs into spaces, nested folders and collections. Search everything, auto-save sessions, sleep idle tabs and import bookmarks.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "alarms",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Shelf",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open Shelf"
    }
  },
  "key": "",
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "homepage_url": "https://github.com/alqushaibi/shelf"
}